# ── Vertex AI (recommended) ──────────────────────────────────────────────────
# Route LLM calls through Vertex AI using Application Default Credentials.
# Run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=gdgagentathon-kenn
GOOGLE_CLOUD_LOCATION=us-central1

# ── AI Studio (alternative) ───────────────────────────────────────────────────
# If you prefer AI Studio over Vertex AI, comment out the block above,
# set GOOGLE_GENAI_USE_VERTEXAI=0, and provide a key from aistudio.google.com.
# GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_API_KEY=your-api-key-here

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8080
